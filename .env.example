# Copy to .env (never commit it)
APP_ENV=production
# python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me-too
# Public URL of the site (used in password-reset emails)
APP_BASE_URL=https://your-domain.example
# Only for plain-http local testing of the production build; keep true behind HTTPS
# COOKIE_SECURE=false
CORS_ORIGINS=https://your-domain.example

# AI tutor (optional: without a key the tutor runs in offline demo mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_DAILY_LIMIT=60

# Password-reset email (optional: without SMTP the reset link is only written to the server log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Sanskrit Saathi <no-reply@your-domain.example>
